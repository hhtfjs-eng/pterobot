# ============================================================
#  PteroBot configuration — copy this file to `.env` and fill
#  in every value.  NEVER share your .env or commit it to git.
# ============================================================

# --- Discord -------------------------------------------------
# Bot token: Discord Developer Portal -> Applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID: Discord Developer Portal -> your app -> General Information -> APPLICATION ID
CLIENT_ID=
# Your server ID (Developer Mode -> right-click server -> Copy ID).
# Commands then appear INSTANTLY. Leave empty to register globally (up to 1h delay).
GUILD_ID=

# --- NaraRouter AI (https://router.bynara.id) ----------------
# API key from your NaraRouter account. Leave empty to disable AI.
# ⚠ Paste the key on ONE single line, with NO quotes and NO spaces:
#      NARA_API_KEY=sk-xxxxxxxxxxxxxxxx
# The bot cleans common paste damage (quotes / line-wraps / invisible
# characters) automatically, verifies the key at startup and prints a MASKED
# fingerprint like sk-abc…wxyz (48 chars) in the console — compare it with
# your NaraRouter dashboard to confirm the right key is loaded. /settings
# shows the same fingerprint. Restart the bot after changing this file.
NARA_API_KEY=
# Model name (e.g. "auto" or a specific model from your account)
NARA_MODEL=auto
# Optional FASTER model used ONLY for ticket auto-replies (e.g. a small/
# fast model from your account). Empty = same as NARA_MODEL.
NARA_TICKET_MODEL=
# Base URL of the NaraRouter API. Leave as-is; only change it if
# NaraRouter tells you to or if they move domains.
NARA_URL=https://router.bynara.id/v1
# --- /update editor AI (v1.8.0 + v1.8.1) ------------------------
# A SECOND, SEPARATE NaraRouter key used ONLY by /update — the command that
# lets the bot edit ITS OWN CODE from Discord ("add a /8ball command",
# "remove /8ball", "make /ping show the server name").
# It never touches the chat key above and the chat key never touches it:
# you can rotate / revoke either one independently.
# Leave empty to fall back to the MAIN NARA_API_KEY (the reply will then
# warn that the key is shared).  Same paste rules: ONE line, no quotes.
NARA_EDITOR_API_KEY=
# Optional: a different model for editing (e.g. a stronger code model).
# Empty = same as NARA_MODEL.
NARA_EDITOR_MODEL=

# --- Modrinth / CurseForge installer (optional) ----------------
# /optimize and /install download from Modrinth — that needs NO key.
# To ALSO search & install from CurseForge, create an API key at
# https://console.curseforge.com/ (free) and paste it here. Leave
# empty to use Modrinth only.
CURSEFORGE_API_KEY=

# --- Pterodactyl Panel ---------------------------------------
# Your panel URL, e.g. https://panel.example.com
PTERODACTYL_URL=
# Client key (user key): panel -> Account -> API Credentials -> Create  (starts with ptlc_)
PTERODACTYL_CLIENT_KEY=
# Application key (admin): panel -> Admin -> API Keys (application) (starts with ptla_)
PTERODACTYL_APPLICATION_KEY=

# --- Storage -------------------------------------------------
# SQLite database location (created automatically)
DATABASE_PATH=./data/bot.sqlite

# --- AI feature switches -------------------------------------
# Master switch for /ai, /smart and DM AI chat
AI_ENABLED=true
# AI tools inside tickets (summarize / suggest / auto-reply)
AI_TICKET_ENABLED=true
# Let the AI answer members automatically in NEW tickets. Default ON since
# v1.6.0 — only STAFF can enable/disable the ticket AI (per-ticket button,
# /ticket ai toggle, /settings ticket-ai). Staff can also pause it per channel
# by saying "noctis i will reply now".
AI_AUTO_REPLY=true
# Mention AI (default ON): pinging the bot WITH A MESSAGE replies with the
# AI — no /ai needed. /ai, /smart and every other command stay unchanged.
# The bot-ping emoji storm is skipped when the AI answers instead.
# Per-server toggle: /settings mention-ai.
MENTION_AI_ENABLED=true
# v1.7.0 — every AI reply (slash, mention, noctis chat) first runs a live
# panel diagnosis of YOUR linked account + servers and auto-fixes stopped/
# crashed servers in the same reply. No env needed — it is always on.
# The "noctis ping @user [N times]" trigger is gated per-server by
# /settings auto-ping (default ON).

# --- Auto-link ------------------------------------------------
# Automatically link Discord users to panel users with the SAME username on
# first use, and grant them access to the servers their panel account owns.
# Toggle per-server with /settings autolink. Manual /link always overrides.
AUTO_LINK=true

# --- Minecraft player bot (/bot — v1.9.0) --------------------
# /bot join drops a REAL player (mineflayer) into one of your panel servers.
# REQUIRED PACKAGES (one-time, on the panel):
#   npm install mineflayer mineflayer-pathfinder mineflayer-collectblock
# The bot still boots without them — /bot then shows this fix message.
#
# Offline-mode servers (the default on Pterodactyl): leave both empty and set
# the in-game name with the /bot join username option (default "Noctis").
#
# ONLINE-mode (premium) servers: set BOTH values below to a Microsoft account
# that owns Minecraft — the bot then logs in with real Microsoft auth (the
# username option is ignored, the account's gamertag is used).
#MC_ACCOUNT_EMAIL=
#MC_ACCOUNT_PASSWORD=

# --- Ping reactions ------------------------------------------
# Master switch: react to @everyone / @here pings (and bot pings, below)
REACT_EVERYONE=true
# React with EVERY emoji uploaded to the server (up to 20 per message —
# Discord's cap). false = single 📢/🔔 stamp instead.
REACT_ALL_EMOJIS=true
# Also react when someone pings the bot directly (not just @everyone/@here)
REACT_BOT_PING=true
# Fallback emojis when the server has no custom emojis
EVERYONE_EMOJI=📢
HERE_EMOJI=🔔

# --- Discord IDs ---------------------------------------------
# Channel that receives audit logs (right-click channel -> Copy ID)
LOG_CHANNEL_ID=
# Role IDs (Server Settings -> Roles -> right-click -> Copy ID)
ADMIN_ROLE_ID=
STAFF_ROLE_ID=
SUPPORT_ROLE_ID=

# --- Optional branding ---------------------------------------
# Display name used in embeds
BOT_NAME=PteroBot
# YOUR hosting brand — the AI ONLY represents this brand and NEVER
# recommends other hosts (it tells users to open a ticket / ask staff instead).
BRAND_NAME=DevAvoid

# --- /status live board (v1.19+) ------------------------------
# How often the board re-renders itself, in minutes (5-60, default 5).
# STATUS_REFRESH_MINUTES=5
# The board probes every node's wings daemon directly to decide
# 🟢/🔴 (the panel API has no online flag). If the probe is firewalled
# from where the bot runs, nodes with RUNNING servers still show green
# ("Online (probe blocked)") and red nodes explain WHY they failed
# (port closed / DNS / TLS / HTTP status). Set false to skip probing
# entirely — nodes then show Available unless in maintenance.
# STATUS_PROBE=true
# Per-URL probe timeout in ms (500-15000, default 2500). Raise it on
# slow networks before assuming a node is down.
# STATUS_PROBE_TIMEOUT=2500
